  lines:
  - "\u041F\u0440\u0438\u0432\u0456\u0442, \u044F \u041E\u043B\u0456\u0432\u0456\u044F
    \u2014 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0439 \u043C\u0435\u0434\u0438\u043A.
    \r\n\u042F \u043C\u043E\u0436\u0443 \u0432\u0438\u043B\u0456\u043A\u0443\u0432\u0430\u0442\u0438
    \u0442\u0435\u0431\u0435 \u043D\u0430 {heal} HP \u043B\u0438\u0448\u0435 \u0437\u0430
    {cost} \u043C\u043E\u043D\u0435\u0442.\r\n\u041F\u0430\u043C\u2019\u044F\u0442\u0430\u0439,
    \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F \u2014 \u0446\u0435 \u043D\u0430\u0439\u0446\u0456\u043D\u043D\u0456\u0448\u0435,
    \u0449\u043E \u0442\u0438 \u043C\u0430\u0454\u0448\r"
